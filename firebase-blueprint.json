{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Patient information",
      "type": "object",
      "properties": {
        "chart": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "birth": { "type": "string", "maxLength": 32 },
        "sex": { "type": "string", "maxLength": 8 },
        "tel": { "type": "string", "maxLength": 32 },
        "ins": { "type": "string", "maxLength": 32 },
        "mail": { "type": "string", "maxLength": 128 },
        "mailok": { "type": "boolean" },
        "smsok": { "type": "boolean" },
        "agree": { "type": "boolean" },
        "addr": { "type": "string", "maxLength": 256 },
        "alg": { "type": "string", "maxLength": 128 },
        "memo": { "type": "string", "maxLength": 512 },
        "blood": { "type": "string", "maxLength": 16 }
      },
      "required": ["chart", "name"]
    },
    "Visit": {
      "title": "Visit",
      "description": "Outpatient visit / reception record",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 16 },
        "chart": { "type": "string", "maxLength": 32 },
        "dept": { "type": "string", "maxLength": 64 },
        "doc": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 32 },
        "kind": { "type": "string", "maxLength": 64 },
        "memo": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "maxLength": 32 }
      },
      "required": ["chart", "date"]
    },
    "Record": {
      "title": "Record",
      "description": "General application record",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 64 },
        "chart": { "type": "string", "maxLength": 32 },
        "data": { "type": "string" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["type"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": { "$ref": "Patient" },
      "description": "Patients collection"
    },
    "/visits/{visitId}": {
      "schema": { "$ref": "Visit" },
      "description": "Visits collection"
    },
    "/records/{recordId}": {
      "schema": { "$ref": "Record" },
      "description": "Generic app records collection"
    }
  }
}
